# Copy to .env locally if needed. Never commit real values.
# Miner supplies these at Lium / worker deploy time.

# ---------------------------------------------------------------------------
# Required in the recipe container env (LLM gate)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Host-side only (NEVER bake into the image)
# ---------------------------------------------------------------------------
# LIUM_API_KEY=
# Base / master coordination URL (worker plane)
# BASE_API_URL=https://chain.joinbase.ai
# PRISM_MASTER_URL=https://chain.joinbase.ai
# Miner hotkey binding (SS58) used when enrolling the worker agent
# MINER_HOTKEY_SS58=
# Wallet / hotkey name on the signing host (remote-sign; private key never leaves host)
# BT_WALLET_NAME=
# BT_HOTKEY_NAME=

# ---------------------------------------------------------------------------
# Smoke / CI overrides (budget only; egalitarian offset identity unchanged)
# ---------------------------------------------------------------------------
# PRISM_RECIPE_TOKEN_BUDGET=256
# PRISM_RECIPE_SMOKE=1
# PRISM_RECIPE_SMOKE_SKIP_GATE=1
